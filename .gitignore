.DS_Store
.build/
.swiftpm/
tmp/
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
Apps/HIL/CyrinxHIL.xcodeproj/xcuserdata/
Apps/HIL/CyrinxHIL.xcodeproj/project.xcworkspace/xcuserdata/
artifacts/
benchmark_files.txt
benchmark_rules.txt
Apps/HIL/android/.gradle/
Apps/HIL/android/.idea/
Apps/HIL/android/**/build/
Apps/HIL/android/local.properties
__pycache__/
scratch/hw20k/data/*.pcm
scratch/hw20k/data/*.npy
scratch/hw20k/data/*.wav
.claude/

# iOS HIL runtime artifacts (regenerated each run)
scratch/hw20k/data/ios_result.json
scratch/hw20k/data/_empty_result.json

# compiled artifacts (never tracked)
*.class
*.dex
*.o
*.a

# library codec dylib (regenerable; see scratch/hw20k/clib.py)
*.dylib

# LaTeX build artifacts. latexmk builds into docs/whitepaper/out/ (see
# docs/whitepaper/.latexmkrc) and copies the finished PDF back beside the .tex.
# The .tex, .latexmkrc, and committed .pdf are tracked; nothing else is.
docs/whitepaper/out/
docs/whitepaper/*.aux
docs/whitepaper/*.log
docs/whitepaper/*.out
docs/whitepaper/*.fls
docs/whitepaper/*.fdb_latexmk
docs/whitepaper/*.bbl
docs/whitepaper/*.blg
docs/whitepaper/*.toc

# local python env (bench harness)
.venv/

# forward insurance before/after the public flip: never commit credentials
.env
.env.*
*.pem
*.key
*.p12
*.keystore
*.jks
